    <uses-permission android:name="android.permission.INTERNET"/>
    
    <!-- Development-only cleartext HTTP configuration for local Flask backend (10.0.2.2 / LAN IP).
         This file is ONLY merged in debug builds and is excluded from production release builds. -->
