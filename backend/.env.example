# CampusTrack Environment Configuration Template
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=campustrack

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-secure-random-256-bit-key
JWT_EXPIRATION_HOURS=24

# Email Delivery Configuration (Option A: SMTP e.g. Gmail / Brevo / Zoho / Outlook)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER="CampusTrack Academic Portal <noreply@campustrack.edu>"
FRONTEND_URL=http://localhost:5000

# Email Delivery Configuration (Option B: API Providers)
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...
